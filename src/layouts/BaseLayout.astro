---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shaik Saleem | AI & Data Science Student — CBIT Hyderabad",
  description = "Personal portfolio of Shaik Saleem, undergraduate Artificial Intelligence and Data Science student at CBIT Hyderabad. Exploring machine learning, data pipelines, and software engineering."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shaik Saleem" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="slsVyTqdo_5us_WFUiHibRkCVQhUGfkBUFqLAvU0bw8" />
    <link rel="canonical" href="https://shaiksaleem.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Playfair Display + Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600;1,700&display=swap" rel="stylesheet">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Shaik Saleem Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#F5ECDA" />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[#743014] selection:text-[#F5ECDA]">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
