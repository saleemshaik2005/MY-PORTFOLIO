---
// Navbar.astro
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#F5ECDA]/90 backdrop-blur-md border-b border-[#E8D1A7]/80 shadow-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand / Name with Editorial Serif touch -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-10 h-10 rounded-full bg-[#442D1C] text-[#F5ECDA] font-bold flex items-center justify-center text-sm shadow-xs group-hover:bg-[#743014] transition-colors">
        {personal.initials}
      </div>
      <div class="flex flex-col">
        <span class="font-display font-bold text-lg tracking-tight text-[#442D1C] group-hover:text-[#743014] transition-colors">
          {personal.name}
        </span>
        <span class="text-xs text-[#74563E] font-medium tracking-wide">
          CBIT · AI & Data Science
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-[#442D1C]">
      <a href="#about" class="nav-link py-1 hover:text-[#743014]">About</a>
      <a href="#projects" class="nav-link py-1 hover:text-[#743014]">Projects</a>
      <a href="#skills" class="nav-link py-1 hover:text-[#743014]">Skills</a>
      <a href="#education" class="nav-link py-1 hover:text-[#743014]">Education</a>
      <a href="#contact" class="nav-link py-1 hover:text-[#743014]">Contact</a>
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={personal.resumePdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        download="Shaik_Saleem_Resume.pdf"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold tracking-wide uppercase rounded-full bg-[#442D1C] text-[#F5ECDA] hover:bg-[#743014] hover:shadow-md transition-all active:scale-95"
      >
        <span>Resume</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-[#442D1C] hover:bg-[#E8D1A7]/50 focus:outline-none"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#E8D1A7] bg-[#F5ECDA]/98 px-6 pt-4 pb-8 space-y-4 shadow-lg">
    <nav class="flex flex-col space-y-3 text-base font-medium text-[#442D1C]">
      <a href="#about" class="mobile-nav-link py-2 hover:text-[#743014]">About</a>
      <a href="#projects" class="mobile-nav-link py-2 hover:text-[#743014]">Projects</a>
      <a href="#skills" class="mobile-nav-link py-2 hover:text-[#743014]">Skills</a>
      <a href="#education" class="mobile-nav-link py-2 hover:text-[#743014]">Education</a>
      <a href="#contact" class="mobile-nav-link py-2 hover:text-[#743014]">Contact</a>
    </nav>
    <div class="pt-3 border-t border-[#E8D1A7]">
      <a
        href={personal.resumePdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        download="Shaik_Saleem_Resume.pdf"
        class="w-full flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold uppercase rounded-full bg-[#442D1C] text-[#F5ECDA] hover:bg-[#743014] transition-colors"
      >
        <span>Download Resume (PDF)</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
