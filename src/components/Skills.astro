---
// Skills.astro
import { portfolioData } from '../data/portfolioData';

const { skillCategories } = portfolioData;
---

<section id="skills" class="py-16 md:py-20 border-b border-[#E8D1A7] bg-[#FAF4E8]/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <div class="section-eyebrow mb-3">
          <span>03 // Technical Competence</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter text-[#442D1C] leading-none">
          Technical <span class="font-display italic font-normal text-[#84592B]">Toolkit</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#74563E] max-w-xl">
          Core programming languages, machine learning frameworks, data science tooling, and CS fundamentals practiced through engineering projects and curriculum.
        </p>
      </div>
    </div>

    <!-- 2-Column Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => (
        <div class="p-6 sm:p-7 rounded-3xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-bold text-[#442D1C] mb-1">
              {category.name}
            </h3>
            <p class="text-xs text-[#84592B] mb-4 font-mono">
              {category.description}
            </p>

            <!-- Pill Badges Cloud -->
            <div class="flex flex-wrap gap-2 mb-4">
              {category.skills.map((skill) => (
                <span class="pill py-1 px-3 text-xs bg-[#F5ECDA] text-[#442D1C] border-[#D4BC8E] font-semibold">
                  {skill.name}
                </span>
              ))}
            </div>
          </div>

          <!-- Quick Context List -->
          <div class="pt-3 border-t border-[#E8D1A7]/70 space-y-2 text-xs text-[#74563E]">
            {category.skills.slice(0, 3).map((skill) => (
              <div class="flex items-start gap-2">
                <span class="text-[#84592B] font-bold shrink-0">•</span>
                <span><strong class="text-[#442D1C]">{skill.name}:</strong> {skill.levelEvidence}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
