---
// Skills.astro
import { portfolioData } from '../data/portfolioData';

const { skillCategories } = portfolioData;
---

<section id="skills" class="py-16 md:py-20 border-b border-slate-200 dark:border-slate-800/80 bg-slate-50/50 dark:bg-[#080b12]/50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <span>02 // Technical Competence</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Evidence-Backed Skills
      </h2>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400 max-w-2xl">
        Rather than arbitrary percentage bars, here is an honest summary of the tools, languages, and mathematical frameworks I have studied, implemented, and can discuss technically.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => (
        <div class="p-6 rounded-xl bg-white dark:bg-[#0e131f] border border-slate-200 dark:border-slate-800 shadow-2xs">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">
            {category.name}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 font-mono">
            {category.description}
          </p>

          <ul class="space-y-3.5">
            {category.skills.map((skill) => (
              <li class="border-t border-slate-100 dark:border-slate-800/80 pt-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                    {skill.name}
                  </span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                  {skill.levelEvidence}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
