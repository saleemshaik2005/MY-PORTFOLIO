---
// Skills.astro
import { portfolioData } from '../data/portfolioData';

const { skillCategories } = portfolioData;
---

<section id="skills" class="py-20 md:py-28 border-b border-[#E8D1A7] bg-[#FAF4E8]/60 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-14">
      <div class="section-eyebrow mb-3">
        <span>03 // Technical Competence</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#442D1C]">
        Evidence-Backed <span class="italic font-normal text-[#84592B]">Foundations</span>
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#74563E] max-w-2xl">
        Instead of arbitrary percentage bars, here is a contextual breakdown of the languages, algorithms, and libraries I have studied, applied, and can discuss technically.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => (
        <div class="p-7 rounded-2xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft">
          <h3 class="font-display text-xl font-bold text-[#442D1C] mb-1">
            {category.name}
          </h3>
          <p class="text-xs text-[#84592B] mb-5 font-mono">
            {category.description}
          </p>

          <ul class="space-y-4">
            {category.skills.map((skill) => (
              <li class="border-t border-[#E8D1A7]/70 pt-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-bold text-[#442D1C]">
                    {skill.name}
                  </span>
                </div>
                <p class="text-xs text-[#74563E] leading-relaxed">
                  {skill.levelEvidence}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
