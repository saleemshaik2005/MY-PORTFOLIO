---
// AboutStory.astro
import { portfolioData } from '../data/portfolioData';

const { personal, quickFacts } = portfolioData;
---

<section class="py-20 md:py-28 border-b border-[#E8D1A7] bg-[#FAF4E8]/60 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-eyebrow mb-3">
      <span>01 // About Me</span>
    </div>
    
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#442D1C] mb-6">
      Driven by Curiosity, Grounded in <span class="italic font-normal text-[#743014]">Fundamentals</span>.
    </h2>

    <p class="text-base sm:text-lg text-[#74563E] leading-relaxed mb-12 max-w-3xl">
      {personal.aboutStory}
    </p>

    <!-- Quick Facts Grid with warm card styling -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {quickFacts.map((fact) => (
        <div class="p-5 rounded-2xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft">
          <div class="text-[11px] font-bold text-[#84592B] uppercase tracking-wider mb-1 font-mono">
            {fact.label}
          </div>
          <div class="font-display font-bold text-lg text-[#442D1C] mb-1">
            {fact.value}
          </div>
          <div class="text-xs text-[#74563E]">
            {fact.detail}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
