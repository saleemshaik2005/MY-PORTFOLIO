---
// AboutStory.astro
import { portfolioData } from '../data/portfolioData';

const { personal, quickFacts } = portfolioData;
---

<section id="about" class="py-16 md:py-24 border-b border-[#E8D1A7] bg-[#F5ECDA] relative overflow-hidden">
  <!-- Warm ambient glow -->
  <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-[#84592B]/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-80 h-80 rounded-full bg-[#743014]/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="section-eyebrow mb-3 text-[#84592B] flex items-center gap-2">
      <span class="w-8 h-px bg-[#84592B] inline-block"></span>
      <span>01 // About Me</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Story & Philosophy -->
      <div class="md:col-span-7">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter text-[#442D1C] leading-none mb-6">
          Hey there!<br />
          <span class="font-display italic font-normal text-[#743014]">I'm Saleem</span>
        </h2>

        <div class="space-y-4 text-base sm:text-lg text-[#74563E] leading-relaxed mb-8">
          <p>
            I'm a 5th-semester undergraduate in <strong class="text-[#442D1C]">Artificial Intelligence and Data Science</strong> at <strong class="text-[#442D1C]">{personal.institution}</strong>.
          </p>
          <p>
            My engineering work centers on building reliable systems—from training and benchmarking machine learning models to architecting regulatory computer vision inspection pipelines. I value computational rigor, clean abstractions, and verifiable claims over hype.
          </p>
        </div>

        <!-- Guiding Philosophy Card -->
        <div class="p-5 rounded-2xl bg-[#E8D1A7]/35 border-l-4 border-l-[#84592B] border border-[#D4BC8E] shadow-soft">
          <div class="text-[11px] font-bold text-[#84592B] uppercase tracking-wider mb-1 font-mono">
            Guiding Philosophy
          </div>
          <p class="font-display italic text-base text-[#442D1C]">
            "{personal.philosophy}"
          </p>
        </div>
      </div>

      <!-- Right Column: Quick Facts 2x2 Alternating Color Grid (Tanmayi Signature Style) -->
      <div class="md:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {quickFacts.map((fact, idx) => {
          const isDark = idx % 2 === 0;
          return (
            <div class={`p-5 rounded-2xl card-hover shadow-soft transition-all ${
              isDark 
                ? 'bg-[#442D1C] text-[#E8D1A7] border border-[#743014]' 
                : 'bg-[#E8D1A7] text-[#442D1C] border border-[#D4BC8E]'
            }`}>
              <div class={`text-[11px] font-bold uppercase tracking-wider mb-1 font-mono ${
                isDark ? 'text-[#9D9167]' : 'text-[#84592B]'
              }`}>
                {fact.label}
              </div>
              <div class={`font-display font-bold text-lg mb-1 leading-snug ${
                isDark ? 'text-[#E8D1A7]' : 'text-[#442D1C]'
              }`}>
                {fact.value}
              </div>
              <div class={`text-xs ${
                isDark ? 'text-[#E8D1A7]/70' : 'text-[#5A3E28]'
              }`}>
                {fact.detail}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
