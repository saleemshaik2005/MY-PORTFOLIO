---
// Footer.astro
import { portfolioData } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
const { personal } = portfolioData;
---

<footer class="py-10 border-t border-[#E8D1A7] bg-[#F5ECDA] text-xs text-[#74563E]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-full bg-[#442D1C] text-[#F5ECDA] font-bold text-[10px] flex items-center justify-center">
        {personal.initials}
      </span>
      <span class="font-medium text-[#442D1C]">
        © {currentYear} {personal.name} · CBIT Hyderabad (AI & DS)
      </span>
    </div>
    <div class="flex items-center gap-4 text-xs font-semibold">
      <a href="#hero" class="text-[#442D1C] hover:text-[#743014] transition-colors">Back to Top ↑</a>
      <span>·</span>
      <a href="https://github.com/saleemshaik2005/MY-PORTFOLIO" target="_blank" rel="noopener noreferrer" class="text-[#743014] hover:underline">
        Portfolio Source ↗
      </a>
    </div>
  </div>
</footer>
