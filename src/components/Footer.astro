---
// Footer.astro
import { portfolioData } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
const { personal, socials } = portfolioData;

const contactCards = [
  {
    name: "GitHub",
    handle: `@${socials.find(s => s.name === 'GitHub')?.handle || 'saleemshaik2005'}`,
    url: socials.find(s => s.name === 'GitHub')?.url || 'https://github.com/saleemshaik2005',
    icon: `<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>`
  },
  {
    name: "LinkedIn",
    handle: socials.find(s => s.name === 'LinkedIn')?.handle || 'saleemshaikatcbit',
    url: socials.find(s => s.name === 'LinkedIn')?.url || 'https://linkedin.com/in/saleemshaikatcbit',
    icon: `<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74V9.93H5.06v8.57h2.8z"></path>`
  },
  {
    name: "LeetCode",
    handle: socials.find(s => s.name === 'LeetCode')?.handle || '@saleem2005',
    url: socials.find(s => s.name === 'LeetCode')?.url || 'https://leetcode.com/u/saleem2005',
    icon: `<path d="M16.102 17.93l-2.697 2.607c-.466.467-1.111.662-1.823.662s-1.357-.195-1.824-.662l-4.332-4.363c-.467-.467-.702-1.15-.702-1.863s.235-1.357.702-1.824l4.319-4.38c.467-.467 1.125-.649 1.837-.649s1.357.195 1.823.662l2.697 2.607c.514.514 1.348.514 1.862 0 .514-.514.514-1.348 0-1.862l-2.697-2.607c-.958-.958-2.316-1.432-3.686-1.432s-2.728.474-3.686 1.432L3.257 12.43c-.958.958-1.432 2.316-1.432 3.686s.474 2.728 1.432 3.686l4.332 4.363c.958.958 2.316 1.432 3.686 1.432s2.728-.474 3.686-1.432l2.697-2.607c.514-.514.514-1.348 0-1.862-.514-.514-1.348-.514-1.862 0zM10.8 11.2h10.4c.7 0 1.3.6 1.3 1.3s-.6 1.3-1.3 1.3H10.8c-.7 0-1.3-.6-1.3-1.3s.6-1.3 1.3-1.3z"></path>`
  },
  {
    name: "Email",
    handle: personal.email,
    url: `mailto:${personal.email}`,
    icon: `<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>`
  }
];
---

<footer id="contact" class="py-24 px-6 relative overflow-hidden bg-[#442D1C] text-[#E8D1A7] border-t border-[#84592B]/40">
  <!-- Warm Ambient Glow Blobs -->
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full opacity-15 pointer-events-none bg-[#84592B] blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full opacity-15 pointer-events-none bg-[#9D9167] blur-3xl"></div>

  <div class="container mx-auto max-w-5xl relative z-10 text-center">
    <!-- Eyebrow -->
    <div class="flex items-center justify-center gap-3 mb-6">
      <span class="w-8 h-px bg-[#9D9167]"></span>
      <span class="text-xs font-bold tracking-widest uppercase text-[#9D9167] font-mono">Get In Touch</span>
      <span class="w-8 h-px bg-[#9D9167]"></span>
    </div>

    <!-- Giant Headline (Tanmayi Style: Let's Create / Something (italic) / Amazing) -->
    <h2 class="text-[clamp(2.8rem,7vw,5.5rem)] font-black leading-[1.05] tracking-tighter mb-6 text-[#E8D1A7]">
      Let's Create<br />
      <span class="font-display italic font-normal text-[#9D9167]">Something</span><br />
      Amazing
    </h2>

    <!-- Subtitle / Bio note -->
    <p class="text-base sm:text-lg max-w-lg mx-auto leading-relaxed mb-10 text-[#E8D1A7]/75 font-normal">
      I'm always excited to collaborate on innovative projects. Open to internships, freelance work, and research collaborations.
    </p>

    <!-- Say Hello Button -->
    <div class="mb-14">
      <a
        href={`mailto:${personal.email}`}
        class="inline-flex items-center gap-2.5 px-10 py-4 rounded-full text-base font-bold tracking-wide transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer"
        style="background: #E8D1A7; color: #442D1C;"
      >
        <span>Say Hello</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Divider Line -->
    <div class="h-px w-full max-w-4xl mx-auto mb-12 bg-[#E8D1A7]/15"></div>

    <!-- 4 Cards Grid (GitHub, LinkedIn, LeetCode, Email) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
      {contactCards.map((card) => (
        <a
          href={card.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-3 p-6 rounded-2xl border transition-all duration-300 group hover:-translate-y-1"
          style="background: rgba(232, 209, 167, 0.05); border-color: rgba(232, 209, 167, 0.12);"
        >
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center transition-transform group-hover:scale-110"
            style="background: rgba(232, 209, 167, 0.08);"
          >
            <svg class="w-5 h-5 text-[#9D9167]" fill="currentColor" viewBox="0 0 24 24" set:html={card.icon} />
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-[#E8D1A7] mb-0.5">
              {card.name}
            </div>
            <div class="text-xs text-[#E8D1A7]/45 font-mono truncate max-w-[130px]">
              {card.handle}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Strip -->
    <div
      class="mt-16 pt-8 border-t flex flex-col md:flex-row items-center justify-between gap-4 text-xs"
      style="border-color: rgba(232, 209, 167, 0.12);"
    >
      <p class="text-[#E8D1A7]/50">
        © {currentYear} {personal.name} — AI & Data Science @ CBIT Hyderabad
      </p>
      <button
        id="footer-back-to-top"
        type="button"
        class="text-xs font-semibold text-[#9D9167] hover:text-[#E8D1A7] transition-colors cursor-pointer flex items-center gap-1"
      >
        Back to Top ↑
      </button>
    </div>
  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('footer-back-to-top');
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
