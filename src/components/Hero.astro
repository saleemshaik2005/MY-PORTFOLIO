---
// Hero.astro
import { portfolioData } from '../data/portfolioData';

const { personal, socials } = portfolioData;
---

<section id="hero" class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden border-b border-[#E8D1A7]">
  <!-- Warm Ambient Glow Blobs -->
  <div class="absolute -top-24 -left-24 w-[500px] h-[500px] bg-[#84592B]/12 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/4 -right-24 w-[500px] h-[500px] bg-[#743014]/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Big Typography Name & Identity -->
      <div class="md:col-span-7 flex flex-col justify-center">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-[#E8D1A7]/50 border border-[#D4BC8E] text-[#442D1C] mb-6 shadow-xs w-fit">
          <span class="w-2 h-2 rounded-full bg-[#743014] animate-pulse"></span>
          <span class="tracking-wide">{personal.availabilityStatus}</span>
        </div>

        <!-- Section Eyebrow -->
        <div class="section-eyebrow mb-3 flex items-center gap-2 text-[#84592B]">
          <span class="w-8 h-px bg-[#84592B] inline-block"></span>
          <span>AI & Data Science Undergrad // CBIT Hyderabad</span>
        </div>

        <!-- Giant Name Headline (Tanmayi Style: First Name Cocoa, Last Name Italic Caramel) -->
        <h1 class="font-black leading-[0.95] text-[clamp(3.5rem,8vw,7rem)] tracking-tighter">
          <span class="block overflow-hidden mb-1 text-[#442D1C]">
            Shaik
          </span>
          <span class="block overflow-hidden mb-6 font-display italic text-[#84592B]">
            Saleem
          </span>
        </h1>

        <!-- Subtitle / Bio -->
        <p class="text-base sm:text-lg text-[#74563E] leading-relaxed mb-6 max-w-xl font-normal">
          5th-semester <strong class="font-bold text-[#442D1C]">Artificial Intelligence & Data Science</strong> undergraduate at <strong class="text-[#442D1C]">{personal.institution}</strong>. Building verifiable machine learning baselines, automated document intelligence pipelines, and reliable full-stack applications.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 mb-8">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 text-xs sm:text-sm font-bold tracking-wide uppercase rounded-full bg-[#442D1C] text-[#F5ECDA] hover:bg-[#743014] shadow-autumn hover:shadow-lg transition-all active:scale-95"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <a
            href={personal.resumePdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            download="Shaik_Saleem_Resume.pdf"
            class="inline-flex items-center gap-2 px-6 py-3 text-xs sm:text-sm font-bold tracking-wide uppercase rounded-full border-2 border-[#442D1C] text-[#442D1C] hover:bg-[#E8D1A7]/50 transition-colors"
          >
            <span>Resume (PDF)</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </a>

          <button
            id="hero-copy-email-btn"
            type="button"
            data-email={personal.email}
            class="inline-flex items-center gap-2 px-4 py-3 text-xs sm:text-sm font-semibold rounded-full text-[#442D1C] hover:bg-[#E8D1A7]/40 transition-colors cursor-pointer"
            title="Copy email address"
          >
            <svg class="w-4 h-4 text-[#84592B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <span id="hero-copy-text">Copy Email</span>
          </button>
        </div>

        <!-- Social Links Strip -->
        <div class="flex items-center gap-5 text-xs font-semibold text-[#74563E]">
          <span>📍 {personal.location}</span>
          <span class="w-1 h-1 rounded-full bg-[#84592B]"></span>
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#442D1C] hover:text-[#743014] font-bold underline underline-offset-4 decoration-[#D4BC8E] hover:decoration-[#743014] transition-colors"
            >
              {s.name} ↗
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Profile Image with Signature Layered Frame & Floating Badges -->
      <div class="md:col-span-5 flex justify-center md:justify-end">
        <div class="relative w-fit">
          <!-- Offset Background Layer 1 -->
          <div class="absolute inset-0 rounded-[2rem] translate-x-4 translate-y-4 bg-[#84592B]/20 pointer-events-none"></div>
          
          <!-- Offset Border Layer 2 -->
          <div class="absolute inset-0 rounded-[2rem] translate-x-2 translate-y-2 border-2 border-[#9D9167]/80 pointer-events-none"></div>

          <!-- Main Profile Photo -->
          <div class="relative overflow-hidden rounded-[2rem] shadow-autumn bg-[#FAF4E8] border border-[#E8D1A7]">
            <img
              src="/images/shaik-saleem.jpg"
              alt="Shaik Saleem"
              class="w-[280px] sm:w-[320px] md:w-[350px] aspect-[4/5] object-cover object-center hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>

          <!-- Floating Badge 1: Top Right (Dark Cocoa Card - LeetCode) -->
          <a
            href="https://leetcode.com/u/saleem2005"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute -right-3 sm:-right-6 -top-3 sm:top-6 rounded-2xl px-4 py-3 shadow-autumn bg-[#442D1C] text-[#F5ECDA] border border-[#743014] card-hover group block"
            title="View LeetCode Profile"
          >
            <div class="text-base sm:text-lg font-black text-[#E8D1A7] font-display flex items-center gap-1.5">
              <span>LeetCode</span>
              <span class="text-xs text-[#9D9167] group-hover:translate-x-0.5 transition-transform">↗</span>
            </div>
            <div class="text-[10px] font-semibold uppercase tracking-wider text-[#D4BC8E] font-mono">
              @saleem2005
            </div>
          </a>

          <!-- Floating Badge 2: Bottom Left (Parchment Card - 8.18 CGPA Tanmayi Style) -->
          <div class="absolute -left-3 sm:-left-6 bottom-4 sm:bottom-6 rounded-2xl px-4 sm:px-5 py-3 sm:py-3.5 shadow-autumn bg-[#F5ECDA] border border-[#D4BC8E] pointer-events-none">
            <div class="text-2xl sm:text-3xl font-black text-[#743014] font-display leading-none">
              8.18
            </div>
            <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-[#9D9167] font-mono mt-1">
              CGPA · CBIT
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-email-btn');
  const copyText = document.getElementById('hero-copy-text');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (email) {
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) {
          copyText.textContent = 'Copied! ✓';
          setTimeout(() => {
            copyText.textContent = 'Copy Email';
          }, 2500);
        }
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    }
  });
</script>
