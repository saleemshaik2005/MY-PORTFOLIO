---
// Hero.astro
import { portfolioData } from '../data/portfolioData';

const { personal, socials } = portfolioData;
---

<section id="about" class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden border-b border-[#E8D1A7]">
  <!-- Warm Ambient Glow Blobs -->
  <div class="absolute -top-20 -left-20 w-[420px] h-[420px] bg-[#84592B]/12 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 -right-20 w-[460px] h-[460px] bg-[#743014]/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-[#E8D1A7]/50 border border-[#D4BC8E] text-[#442D1C] mb-8 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-[#743014] animate-pulse"></span>
      <span class="tracking-wide">{personal.availabilityStatus}</span>
    </div>

    <!-- Editorial Section Eyebrow -->
    <div class="section-eyebrow mb-4">
      <span>AI & Data Science Undergraduate // CBIT Hyderabad</span>
    </div>

    <!-- Giant Playfair Display Headline -->
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-[#442D1C] leading-[1.1] mb-6">
      Building with <span class="italic font-normal text-[#743014]">Rigor</span>, Exploring with <span class="italic font-normal text-[#84592B]">Curiosity</span>.
    </h1>

    <!-- Subtitle / Bio -->
    <p class="text-lg sm:text-xl text-[#74563E] leading-relaxed mb-8 max-w-3xl font-normal">
      I'm <strong class="font-bold text-[#442D1C]">{personal.name}</strong>, a 5th-semester undergraduate at <strong class="text-[#442D1C]">{personal.institution}</strong>. I bridge computational theory and practical implementation—training machine learning baselines, designing data pipelines, and building clean, verifiable software systems.
    </p>

    <!-- Editorial Quote / Mindset Box -->
    <div class="p-6 rounded-2xl bg-[#FAF4E8] border border-[#E8D1A7] shadow-soft mb-10 max-w-3xl relative">
      <div class="text-[11px] font-bold text-[#84592B] uppercase tracking-widest mb-1.5">
        Guiding Philosophy
      </div>
      <blockquote class="font-display italic text-base sm:text-lg text-[#442D1C] leading-snug">
        "{personal.philosophy}"
      </blockquote>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-4 mb-12">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-7 py-3 text-sm font-bold tracking-wide uppercase rounded-full bg-[#442D1C] text-[#F5ECDA] hover:bg-[#743014] shadow-autumn hover:shadow-lg transition-all active:scale-95"
      >
        <span>Explore Projects</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>

      <a
        href={personal.resumePdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        download="Shaik_Saleem_Resume.pdf"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold tracking-wide uppercase rounded-full border border-[#442D1C] text-[#442D1C] hover:bg-[#E8D1A7]/50 transition-colors"
      >
        <span>Download Resume (PDF)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
      </a>

      <button
        id="hero-copy-email-btn"
        type="button"
        data-email={personal.email}
        class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold rounded-full text-[#442D1C] hover:bg-[#E8D1A7]/40 transition-colors cursor-pointer"
        title="Copy email address"
      >
        <svg class="w-4 h-4 text-[#84592B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <span id="hero-copy-text">Copy Email</span>
      </button>
    </div>

    <!-- Metadata Strip -->
    <div class="pt-8 border-t border-[#E8D1A7]/80 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-[#74563E]">
      <div class="flex items-center gap-6">
        <span>📍 {personal.location}</span>
        <span>🎓 {personal.semester}</span>
      </div>
      <div class="flex items-center gap-4">
        {socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#442D1C] hover:text-[#743014] font-bold underline underline-offset-4 decoration-[#D4BC8E] hover:decoration-[#743014] transition-colors"
          >
            {s.name} ↗
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-email-btn');
  const copyText = document.getElementById('hero-copy-text');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (email) {
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) {
          copyText.textContent = 'Copied to clipboard! ✓';
          setTimeout(() => {
            copyText.textContent = 'Copy Email';
          }, 2500);
        }
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    }
  });
</script>
