---
// Projects.astro
import ProjectCard from './ProjectCard.astro';
import { portfolioData } from '../data/portfolioData';

const { projects } = portfolioData;
---

<section id="projects" class="py-16 md:py-20 border-b border-slate-200 dark:border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <span>01 // Selected Work & Case Studies</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Proof of Work Over Arbitrary Claims
      </h2>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400 max-w-2xl">
        Each project highlights the genuine engineering process: defining the real problem, isolating my contribution, understanding data quality hurdles, and explicitly documenting technical limitations.
      </p>
    </div>

    <div class="space-y-8">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
