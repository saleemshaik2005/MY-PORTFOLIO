---
// Projects.astro
import ProjectCard from './ProjectCard.astro';
import { portfolioData } from '../data/portfolioData';

const { projects } = portfolioData;
---

<section id="projects" class="py-20 md:py-28 border-b border-[#E8D1A7] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-14">
      <div class="section-eyebrow mb-3">
        <span>02 // Selected Projects</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#442D1C]">
        Crafted Case Studies & <span class="italic font-normal text-[#743014]">Prototypes</span>
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#74563E] max-w-2xl">
        Each project details the real technical journey: the underlying problem, my specific implementation, dataset constraints, and honest reflections on limitations.
      </p>
    </div>

    <div>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
