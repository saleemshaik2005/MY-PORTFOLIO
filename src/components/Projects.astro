---
// Projects.astro
import ProjectCard from './ProjectCard.astro';
import { portfolioData } from '../data/portfolioData';

const { projects } = portfolioData;
---

<section id="projects" class="py-16 md:py-24 border-b border-[#E8D1A7] relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-30 pointer-events-none bg-[#E8D1A7] blur-3xl -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <div class="section-eyebrow mb-3">
          <span>02 // Selected Projects</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter text-[#442D1C] leading-none">
          Selected <span class="font-display italic font-normal text-[#743014]">Projects</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#74563E] max-w-xl">
          Verifiable software systems, intelligent inspection pipelines, and machine learning models built with full architectural transparency.
        </p>
      </div>

      <a
        href="https://github.com/saleemshaik2005"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 self-start md:self-end px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide bg-[#442D1C] text-[#E8D1A7] hover:bg-[#743014] transition-all shadow-autumn active:scale-95"
      >
        <span>View All on GitHub</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

    <!-- 2-Column Responsive Grid (Tanmayi Style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
