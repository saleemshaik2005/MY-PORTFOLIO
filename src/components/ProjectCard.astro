---
// ProjectCard.astro
import type { Project } from '../data/portfolioData';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Compile slides for recursive presentation
const slides = project.screenshots && project.screenshots.length > 0
  ? project.screenshots
  : (project.image ? [{ url: project.image, caption: project.title }] : []);
---

<article class="rounded-3xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft overflow-hidden flex flex-col justify-between">
  <!-- Card Top: Recursive Slideshow Banner -->
  <div
    class="project-slideshow relative h-56 sm:h-64 overflow-hidden bg-[#24170E] border-b border-[#E8D1A7] group/slider select-none"
    data-slideshow-id={project.id}
  >
    <!-- Slides Track -->
    <div class="slides-track absolute inset-0">
      {slides.map((slide, idx) => (
        <div
          class={`slide-item absolute inset-0 transition-opacity duration-700 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
          data-slide-index={idx}
        >
          <img
            src={slide.url}
            alt={slide.caption}
            class={`w-full h-full ${slide.url.includes('cbit-crest') ? 'object-contain p-8' : 'object-cover object-top'}`}
            loading={idx === 0 ? "eager" : "lazy"}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-black/25 pointer-events-none"></div>
        </div>
      ))}
    </div>

    <!-- Category & Status Pill (Top Left) -->
    <div class="absolute top-3.5 left-3.5 z-20 flex flex-wrap gap-1.5 pointer-events-none">
      <span class="pill py-1 px-3 bg-[#442D1C] text-[#F5ECDA] border-none font-bold text-[11px] shadow-sm">
        {project.category}
      </span>
      {project.badge && (
        <span class="pill py-1 px-2.5 bg-[#84592B] text-[#F5ECDA] border-none font-bold text-[10px] font-mono shadow-sm">
          {project.badge}
        </span>
      )}
    </div>

    <!-- Quick Action Links (Top Right) -->
    <div class="absolute top-3.5 right-3.5 z-20 flex items-center gap-1.5">
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-[#743014] text-[#F5ECDA] flex items-center justify-center hover:bg-[#56230E] shadow-sm hover:scale-110 transition-all active:scale-95 cursor-pointer"
          title="Launch Live App"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-[#442D1C] text-[#E8D1A7] flex items-center justify-center hover:bg-[#2A1B11] shadow-sm hover:scale-110 transition-all active:scale-95 cursor-pointer"
          title="View GitHub Repository"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>
      )}
    </div>

    <!-- Slideshow Controls (For projects with 2+ screenshots) -->
    {slides.length > 1 && (
      <>
        <!-- Previous Arrow -->
        <button
          type="button"
          class="slide-prev absolute left-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/60 hover:bg-black/90 text-[#F5ECDA] flex items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-opacity duration-200 cursor-pointer shadow-md"
          aria-label="Previous slide"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <!-- Next Arrow -->
        <button
          type="button"
          class="slide-next absolute right-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/60 hover:bg-black/90 text-[#F5ECDA] flex items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-opacity duration-200 cursor-pointer shadow-md"
          aria-label="Next slide"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <!-- Bottom Status Bar: Caption & Recursive Indicators -->
        <div class="absolute bottom-2.5 left-3 right-3 z-20 flex items-center justify-between gap-2 pointer-events-none">
          <!-- Slide Caption Pill -->
          <span class="slide-caption text-[10px] font-mono font-medium text-white/95 bg-black/70 px-2.5 py-0.5 rounded-full backdrop-blur-xs truncate max-w-[200px] sm:max-w-[230px] shadow-xs">
            {slides[0]?.caption || ""}
          </span>

          <!-- Dots Strip -->
          <div class="slide-dots flex items-center gap-1.5 pointer-events-auto bg-black/50 px-2 py-1 rounded-full backdrop-blur-xs shadow-xs">
            {slides.map((_, idx) => (
              <button
                type="button"
                class={`dot-btn transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-4 h-1.5 bg-[#E8D1A7]' : 'w-1.5 h-1.5 bg-white/40 hover:bg-white'}`}
                data-dot-index={idx}
                aria-label={`Go to slide ${idx + 1}`}
              />
            ))}
          </div>
        </div>
      </>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <h3 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-[#442D1C]">
          {project.title}
        </h3>
        <span class="text-[11px] font-mono text-[#84592B] font-semibold shrink-0">
          ● {project.status}
        </span>
      </div>

      <p class="text-xs sm:text-sm text-[#74563E] leading-relaxed mb-4">
        {project.tagline}
      </p>

      <!-- Key Highlight / Problem Summary (Warm Caramel Frame) -->
      <div class="p-3.5 rounded-xl bg-[#E8D1A7]/30 border border-[#D4BC8E] text-xs mb-4">
        <span class="font-bold text-[#442D1C] block mb-1">Problem & Solution:</span>
        <span class="text-[#5A3E28] leading-relaxed">{project.problem}</span>
      </div>

      <!-- Tech Stack Badges (Tanmayi Style: Amber / Cocoa Tinted Pills) -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        {project.stack.map(tech => (
          <span
            class="pill py-0.5 px-2.5 text-[11px] font-semibold rounded-full transition-all hover:scale-105"
            style="background: rgba(68, 45, 28, 0.08); color: #84592B; border: 1px solid rgba(132, 89, 43, 0.25);"
          >
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- Collapsible Deep Dive / Technical Specs Drawer -->
    <details class="group mt-2 pt-3 border-t border-[#E8D1A7]/80 text-xs">
      <summary class="font-mono font-bold text-[#84592B] hover:text-[#743014] cursor-pointer flex items-center justify-between py-1 select-none">
        <span>Technical Specs & Architecture</span>
        <span class="text-sm text-[#743014] group-open:rotate-180 transition-transform">▼</span>
      </summary>

      <div class="pt-3 space-y-3">
        <!-- Screenshots & Architecture Gallery -->
        {project.screenshots && project.screenshots.length > 0 && (
          <div class="space-y-2 pt-1">
            <div class="text-[11px] font-mono uppercase font-bold text-[#84592B]">
              Verified System Screenshots:
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {project.screenshots.map((shot) => (
                <div class="rounded-xl overflow-hidden border border-[#D4BC8E] bg-[#F5ECDA]/50 p-1.5 shadow-2xs">
                  <a href={shot.url} target="_blank" rel="noopener noreferrer" class="block group/shot">
                    <img
                      src={shot.url}
                      alt={shot.caption}
                      class="w-full h-32 object-cover object-top rounded-lg group-hover/shot:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                    />
                  </a>
                  <p class="text-[10px] font-mono text-[#74563E] mt-1.5 px-0.5 truncate font-medium" title={shot.caption}>
                    {shot.caption}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="p-3 rounded-lg bg-[#FAF4E8] border border-[#E8D1A7]">
          <strong class="text-[#442D1C] block mb-1">Architecture & Implementation:</strong>
          <p class="text-[#74563E] leading-relaxed">{project.myContribution}</p>
        </div>

        <div class="p-3 rounded-lg bg-[#E8D1A7]/30 border border-[#D4BC8E]">
          <strong class="text-[#743014] block mb-1">Verified Outcomes:</strong>
          <p class="text-[#442D1C] leading-relaxed">{project.metricsOrOutcomes}</p>
        </div>

        <div class="p-3 rounded-lg bg-[#FAF4E8] border border-[#E8D1A7]">
          <strong class="text-[#442D1C] block mb-1">Engineering Reflection & Trade-off:</strong>
          <p class="text-[#74563E] leading-relaxed">{project.limitations}</p>
        </div>
      </div>
    </details>
  </div>
</article>

<script>
  function setupProjectSlideshows() {
    const sliders = document.querySelectorAll<HTMLElement>('.project-slideshow');

    sliders.forEach((slider) => {
      // Prevent double initialization
      if (slider.dataset.initialized === 'true') return;
      slider.dataset.initialized = 'true';

      const slides = slider.querySelectorAll<HTMLElement>('.slide-item');
      if (slides.length <= 1) return;

      const dots = slider.querySelectorAll<HTMLElement>('.dot-btn');
      const captionEl = slider.querySelector<HTMLElement>('.slide-caption');
      const prevBtn = slider.querySelector<HTMLButtonElement>('.slide-prev');
      const nextBtn = slider.querySelector<HTMLButtonElement>('.slide-next');

      let currentIndex = 0;
      let timer: any = null;

      function goToSlide(targetIndex: number) {
        // Recursive wrap-around logic
        const nextIndex = (targetIndex + slides.length) % slides.length;

        // Hide current slide
        slides[currentIndex].classList.remove('opacity-100', 'z-10');
        slides[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');

        // Reset current dot
        if (dots[currentIndex]) {
          dots[currentIndex].className = 'dot-btn transition-all duration-300 rounded-full cursor-pointer w-1.5 h-1.5 bg-white/40 hover:bg-white';
        }

        // Activate next slide
        currentIndex = nextIndex;
        slides[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        slides[currentIndex].classList.add('opacity-100', 'z-10');

        // Widen active dot
        if (dots[currentIndex]) {
          dots[currentIndex].className = 'dot-btn transition-all duration-300 rounded-full cursor-pointer w-4 h-1.5 bg-[#E8D1A7]';
        }

        // Update caption
        const img = slides[currentIndex].querySelector<HTMLImageElement>('img');
        if (captionEl && img) {
          captionEl.textContent = img.alt || '';
        }
      }

      function startSlideshowLoop() {
        if (timer) clearInterval(timer);
        timer = setInterval(() => {
          goToSlide(currentIndex + 1);
        }, 3400); // 3.4s recursive interval
      }

      function stopSlideshowLoop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentIndex + 1);
        startSlideshowLoop();
      });

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentIndex - 1);
        startSlideshowLoop();
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          goToSlide(idx);
          startSlideshowLoop();
        });
      });

      slider.addEventListener('mouseenter', stopSlideshowLoop);
      slider.addEventListener('mouseleave', startSlideshowLoop);

      // Start the recursive loop automatically
      startSlideshowLoop();
    });
  }

  // Run on mount and Astro navigation
  setupProjectSlideshows();
  document.addEventListener('astro:page-load', setupProjectSlideshows);
</script>
