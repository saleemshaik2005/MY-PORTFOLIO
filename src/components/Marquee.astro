---
// Marquee.astro
import { portfolioData } from '../data/portfolioData';

const { marqueeKeywords } = portfolioData;
// Repeat keywords so the seamless marquee has no gaps
const repeatedKeywords = [...marqueeKeywords, ...marqueeKeywords];
---

<div class="relative w-full overflow-hidden py-4 sm:py-5 bg-[#442D1C] border-y border-[#D4BC8E]/40 select-none shadow-inner">
  <div class="marquee-track flex items-center gap-6">
    {repeatedKeywords.map((keyword) => (
      <div class="flex items-center gap-6 shrink-0">
        <span class="text-xs sm:text-sm font-bold tracking-widest uppercase text-[#E8D1A7] font-mono">
          {keyword}
        </span>
        <span class="text-[#9D9167] text-xs">✦</span>
      </div>
    ))}
  </div>
</div>
