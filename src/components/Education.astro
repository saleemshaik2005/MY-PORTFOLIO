---
// Education.astro
import { portfolioData } from '../data/portfolioData';

const { educationHistory, relevantCoursework, certifications } = portfolioData;
---

<section id="education" class="py-16 md:py-20 border-b border-[#E8D1A7] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <div class="section-eyebrow mb-3">
        <span>04 // Academic Foundations</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter text-[#442D1C] leading-none">
        Education & <span class="font-display italic font-normal text-[#743014]">Coursework</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#74563E] max-w-xl">
        Academic progression from secondary foundations to undergraduate engineering in Artificial Intelligence and Data Science at CBIT Hyderabad.
      </p>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Education Progression Timeline -->
      <div class="md:col-span-6 space-y-4">
        <h3 class="font-display text-xl font-bold text-[#442D1C] mb-4 flex items-center gap-2">
          <span>Academic Milestones</span>
        </h3>

        {educationHistory.map((edu, idx) => (
          <div class="p-5 rounded-2xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft">
            <div class="flex items-start justify-between gap-3 mb-2">
              <div>
                <span class="pill py-0.5 px-2.5 bg-[#E8D1A7]/60 text-[#84592B] font-mono text-[10px] mb-1">
                  {idx === 0 ? "Undergraduate Degree" : idx === 1 ? "Intermediate (Class XII)" : "Secondary School (Class X)"}
                </span>
                <h4 class="font-display text-lg font-bold text-[#442D1C] mt-1">
                  {edu.institution}
                </h4>
                <p class="text-xs font-semibold text-[#743014] mt-0.5">
                  {edu.degreeOrQualification}
                </p>
              </div>
              <span class="text-[11px] font-mono font-bold bg-[#E8D1A7]/80 text-[#442D1C] px-2.5 py-1 rounded-full shrink-0">
                {edu.period}
              </span>
            </div>

            <div class="flex items-center justify-between text-xs text-[#74563E] pt-2 border-t border-[#E8D1A7]/60">
              <span>📍 {edu.location}</span>
              {edu.scoreOrDetail && (
                <span class="font-mono font-bold text-[#84592B]">{edu.scoreOrDetail}</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: Coursework & Certifications -->
      <div class="md:col-span-6 space-y-6">
        <!-- Relevant Coursework Grid -->
        <div>
          <h3 class="font-display text-xl font-bold text-[#442D1C] mb-4">
            Core Curriculum Coursework
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {relevantCoursework.map((course) => (
              <div class="p-3.5 rounded-xl bg-[#FAF4E8] border border-[#E8D1A7] hover:border-[#D4BC8E] transition-colors shadow-2xs">
                <span class="block text-xs font-bold text-[#442D1C] mb-0.5">
                  {course.title}
                </span>
                <span class="block text-[11px] text-[#74563E] leading-snug">
                  {course.focus}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <h3 class="font-display text-xl font-bold text-[#442D1C] mb-4">
            Certifications & Courses
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {certifications.map((cert) => (
              <div class="p-3.5 rounded-xl bg-[#FAF4E8] border border-[#E8D1A7] shadow-soft flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-mono text-[#84592B] font-bold block mb-0.5">
                    {cert.issuer}
                  </span>
                  <h4 class="text-xs font-bold text-[#442D1C] mb-1">
                    {cert.title}
                  </h4>
                  <p class="text-[10px] text-[#74563E]">
                    {cert.highlight}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
