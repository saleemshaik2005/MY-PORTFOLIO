---
// Education.astro
import { portfolioData } from '../data/portfolioData';

const { education, certifications } = portfolioData;
---

<section id="education" class="py-20 md:py-28 border-b border-[#E8D1A7] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-14">
      <div class="section-eyebrow mb-3">
        <span>04 // Academic Rigor</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#442D1C]">
        Academic Curriculum at <span class="italic font-normal text-[#743014]">CBIT Hyderabad</span>
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#74563E] max-w-2xl">
        Undergraduate education emphasizing theoretical computer science, statistical reasoning, and artificial intelligence systems.
      </p>
    </div>

    <!-- Main College Institution Box -->
    <div class="p-7 sm:p-9 rounded-2xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft mb-10">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <span class="pill bg-[#E8D1A7]/60 text-[#84592B] font-mono text-[11px] mb-2 inline-block">
            Autonomous · NAAC A++ Accredited
          </span>
          <h3 class="font-display text-2xl font-bold text-[#442D1C]">
            {education.institution}
          </h3>
          <p class="text-sm font-semibold text-[#743014] mt-0.5">
            {education.degree}
          </p>
          <p class="text-xs text-[#74563E] mt-1 font-mono">
            📍 {education.location} · Affiliated with Osmania University
          </p>
        </div>
        <div class="text-left sm:text-right">
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold bg-[#E8D1A7]/80 text-[#442D1C]">
            {education.period}
          </span>
          <p class="text-xs text-[#84592B] font-bold mt-1.5 font-mono">
            {education.semesterStanding}
          </p>
        </div>
      </div>

      <!-- Coursework Grid -->
      <div class="pt-6 border-t border-[#E8D1A7]">
        <h4 class="text-xs font-mono uppercase tracking-wider text-[#84592B] font-bold mb-4">
          Core Algorithmic & AI Coursework
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {education.courses.map((course) => (
            <div class="p-3.5 rounded-xl bg-[#F5ECDA]/80 border border-[#E8D1A7] hover:border-[#D4BC8E] transition-colors">
              <span class="block text-sm font-bold text-[#442D1C] mb-1">
                {course.title}
              </span>
              <span class="block text-xs text-[#74563E] leading-relaxed">
                {course.focus}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Certifications & Independent Study -->
    {certifications.length > 0 && (
      <div>
        <h3 class="font-display text-2xl font-bold text-[#442D1C] mb-5">
          Independent Study & <span class="italic font-normal text-[#84592B]">Certifications</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="p-5 rounded-xl bg-[#FAF4E8] border border-[#E8D1A7] card-hover shadow-soft flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-[#84592B] font-semibold mb-1">
                  <span>{cert.issuer}</span>
                  <span>{cert.date}</span>
                </div>
                <h4 class="text-sm font-bold text-[#442D1C] mb-1.5">
                  {cert.title}
                </h4>
                <p class="text-xs text-[#74563E] leading-relaxed">
                  {cert.highlight}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
