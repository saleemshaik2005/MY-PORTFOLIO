---
// Education.astro
import { portfolioData } from '../data/portfolioData';

const { education, certifications } = portfolioData;
---

<section id="education" class="py-16 md:py-20 border-b border-slate-200 dark:border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <span>03 // Academic Foundations</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Education & Rigorous Coursework
      </h2>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400 max-w-2xl">
        Formal computer science and artificial intelligence curriculum at CBIT Hyderabad, emphasizing core mathematical and algorithmic fundamentals.
      </p>
    </div>

    <!-- Main College Box -->
    <div class="p-6 sm:p-8 rounded-xl bg-white dark:bg-[#0e131f] border border-slate-200 dark:border-slate-800 mb-8">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">
            {education.institution}
          </h3>
          <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mt-0.5">
            {education.degree}
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
            {education.accreditation} · 📍 {education.location}
          </p>
        </div>
        <div class="text-right">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            {education.period}
          </span>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
            {education.semesterStanding}
          </p>
        </div>
      </div>

      <!-- Coursework Grid -->
      <div class="pt-6 border-t border-slate-100 dark:border-slate-800/80">
        <h4 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold mb-4">
          Core Completed & In-Progress Coursework
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {education.courses.map((course) => (
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-[#131926] border border-slate-200/60 dark:border-slate-800/80">
              <span class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-0.5">
                {course.title}
              </span>
              <span class="block text-xs text-slate-600 dark:text-slate-400">
                {course.focus}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Certifications & Independent Study -->
    {certifications.length > 0 && (
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
          Independent Study & Certifications
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="p-4 rounded-lg bg-white dark:bg-[#0e131f] border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-1">
                  <span>{cert.issuer}</span>
                  <span>{cert.date}</span>
                </div>
                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
                  {cert.title}
                </h4>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                  {cert.highlight}
                </p>
              </div>
              {cert.credentialUrl && (
                <div class="mt-3 pt-2 border-t border-slate-100 dark:border-slate-800 text-right">
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline"
                  >
                    Verify Credential ↗
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
