---
// Education.astro
import { portfolioData } from '../data/portfolioData';

const { educationHistory, relevantCoursework, certifications } = portfolioData;
---

<section id="education" class="py-20 md:py-28 border-b border-[#E8D1A7] bg-[#F5ECDA] relative overflow-hidden">
  <!-- Warm ambient glow -->
  <div class="absolute top-1/3 -left-28 w-96 h-96 rounded-full bg-[#84592B]/10 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-28 w-96 h-96 rounded-full bg-[#743014]/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-14">
      <div class="section-eyebrow mb-3 text-[#84592B] flex items-center gap-2">
        <span class="w-8 h-px bg-[#84592B] inline-block"></span>
        <span>04 // Academic Foundations</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter text-[#442D1C] leading-none">
        Experience & <span class="font-display italic font-normal text-[#743014]">Education</span>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-[#74563E] max-w-xl leading-relaxed">
        Academic progression from secondary foundations to undergraduate engineering in Artificial Intelligence and Data Science at CBIT Hyderabad.
      </p>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Education Progression Timeline (Tanmayi Gradient Track) -->
      <div class="md:col-span-6 relative">
        <h3 class="font-display text-xl font-bold text-[#442D1C] mb-6 flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-[#442D1C] text-[#E8D1A7] text-sm">
            🎓
          </div>
          <span>Academic Milestones</span>
        </h3>

        <!-- Vertical Timeline Line -->
        <div class="absolute left-4 top-16 bottom-6 w-0.5 bg-gradient-to-b from-[#84592B] via-[#D4BC8E] to-transparent pointer-events-none hidden sm:block"></div>

        <div class="space-y-4 sm:pl-10">
          {educationHistory.map((edu, idx) => (
            <div class="p-5 sm:p-6 rounded-2xl bg-[#FAF4E8] border border-[#D4BC8E] card-hover shadow-soft relative group">
              <!-- Timeline node point -->
              <span class="absolute -left-[29px] top-7 w-3 h-3 rounded-full bg-[#442D1C] border-2 border-[#E8D1A7] hidden sm:block group-hover:scale-125 transition-transform"></span>

              <div class="flex items-start justify-between gap-3 mb-2">
                <div>
                  <span class="pill py-0.5 px-2.5 bg-[#84592B]/15 text-[#84592B] border border-[#84592B]/25 font-mono text-[10px] mb-1 font-bold">
                    {idx === 0 ? "Undergraduate Degree" : idx === 1 ? "Intermediate (Class XII)" : "Secondary School (Class X)"}
                  </span>
                  <h4 class="font-display text-lg sm:text-xl font-bold text-[#442D1C] mt-1 leading-snug">
                    {edu.institution}
                  </h4>
                  <p class="text-xs font-semibold text-[#743014] mt-0.5">
                    {edu.degreeOrQualification}
                  </p>
                </div>
                <span class="text-[11px] font-mono font-bold bg-[#442D1C] text-[#E8D1A7] px-2.5 py-1 rounded-full shrink-0">
                  {edu.period}
                </span>
              </div>

              <div class="flex items-center justify-between text-xs text-[#74563E] pt-3 border-t border-[#E8D1A7]/80 mt-2">
                <span>📍 {edu.location}</span>
                {edu.scoreOrDetail && (
                  <span class="font-mono font-bold text-[#84592B] bg-[#E8D1A7]/40 px-2 py-0.5 rounded-md">
                    {edu.scoreOrDetail}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Coursework & Certifications -->
      <div class="md:col-span-6 space-y-8">
        <!-- Relevant Coursework Grid -->
        <div>
          <h3 class="font-display text-xl font-bold text-[#442D1C] mb-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-[#442D1C] text-[#E8D1A7] text-sm">
              📚
            </div>
            <span>Core Curriculum Coursework</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {relevantCoursework.map((course) => (
              <div class="p-4 rounded-xl bg-[#FAF4E8] border border-[#D4BC8E] hover:border-[#84592B] transition-all card-hover shadow-2xs">
                <span class="block text-xs font-bold text-[#442D1C] mb-1">
                  {course.title}
                </span>
                <span class="block text-[11px] text-[#74563E] leading-snug">
                  {course.focus}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <h3 class="font-display text-xl font-bold text-[#442D1C] mb-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-[#442D1C] text-[#E8D1A7] text-sm">
              🏆
            </div>
            <span>Certifications & Verified Courses</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {certifications.map((cert) => (
              <div class="p-4 rounded-xl bg-[#FAF4E8] border border-[#D4BC8E] hover:border-[#84592B] transition-all card-hover shadow-soft flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-mono text-[#84592B] font-bold block mb-1">
                    {cert.issuer}
                  </span>
                  <h4 class="text-xs font-bold text-[#442D1C] mb-1 leading-snug">
                    {cert.title}
                  </h4>
                  <p class="text-[10px] text-[#74563E] leading-snug">
                    {cert.highlight}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
