---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import AboutStory from '../components/AboutStory.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { portfolioData } from '../data/portfolioData';

const pageTitle = `${portfolioData.personal.name} | AI & Data Science Student — CBIT Hyderabad`;
const pageDescription = `Personal portfolio and machine learning case studies of ${portfolioData.personal.name}, 5th-semester Artificial Intelligence & Data Science student at CBIT Hyderabad.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main id="main-content" class="flex-1">
    <Hero />
    <Marquee />
    <AboutStory />
    <Projects />
    <Skills />
    <Education />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
